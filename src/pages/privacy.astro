---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
---

<StarlightPage
	frontmatter={{
		title: 'Privacy',
		description: 'Cookieless usage stats with self-hosted Umami: what is counted and how to opt out.',
		pagefind: false,
		editUrl: false,
	}}
>
	<p>
		This documentation counts its visits with a self-hosted <a href="https://umami.is">Umami</a>. No cookies,
		no personal data, no ads, nothing shared with anyone. Just enough to know which pages are read.
		The rigs site at <a href="https://openrig.eu">openrig.eu</a> has its own
		<a href="https://openrig.eu/privacy">privacy page</a>.
	</p>

	<h2>What is counted</h2>
	<ul>
		<li>Pages viewed and the site you came from</li>
		<li>Browser, system, device type, screen size, language and country</li>
		<li>Page load times</li>
		<li>Clicks on links, video plays, code copies and search use</li>
	</ul>

	<h2>What is not</h2>
	<ul>
		<li>No cookies, nothing stored on your device</li>
		<li>No IP addresses kept, no tracking across sites</li>
		<li>What you type in the search box is never sent</li>
	</ul>

	<h2>Opting out</h2>
	<p>
		Nothing is counted when your browser sends Do Not Track or Global Privacy Control. You can also turn it
		off for this site in this browser:
	</p>
	<p class="opt">
		<button type="button" id="umami-opt" hidden></button>
		<span id="umami-state"></span>
	</p>
</StarlightPage>

<script>
	// Umami skips every send while localStorage has umami.disabled
	const button = document.querySelector<HTMLButtonElement>('#umami-opt')!;
	const state = document.querySelector<HTMLElement>('#umami-state')!;
	const render = () => {
		const off = localStorage.getItem('umami.disabled') !== null;
		button.textContent = off ? 'Turn measurement back on' : 'Turn measurement off';
		state.textContent = off ? 'Measurement is off in this browser.' : 'Measurement is on.';
		button.hidden = false;
	};
	button.addEventListener('click', () => {
		if (localStorage.getItem('umami.disabled') !== null) localStorage.removeItem('umami.disabled');
		else localStorage.setItem('umami.disabled', '1');
		render();
	});
	render();
</script>

<style>
	.opt {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		align-items: center;
	}
	.opt button {
		font: inherit;
		font-size: var(--sl-text-sm);
		padding: 0.5rem 1rem;
		border: 1px solid var(--sl-color-gray-4);
		border-radius: 999px;
		background: transparent;
		color: var(--sl-color-white);
		cursor: pointer;
	}
	.opt button:hover {
		border-color: var(--sl-color-accent);
	}
	.opt span {
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
</style>
