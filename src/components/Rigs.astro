---
// Home page section on the rigs site. Its state (coming soon or live) and its
// links are set in src/rigs.mjs.
import { GITHUB_URL, REDDIT_URL, RIGS_LIVE, RIGS_URL } from '../rigs.mjs';
// The chain, drawn by the rigs site's rack renderer (the app's rack: shapes,
// family colours, LEDs and the TONE3000 mark on models from TONE3000)
import rackSvg from '../assets/rig-rack.svg?raw';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const state = RIGS_LIVE ? 'live' : 'soon';
const rack = rackSvg.replaceAll('/static/t3k-mark.svg', `${base}/t3k-mark.svg`);
---

<section id="rigs" class="band">
	<div class="wrap">
		<div class="feature flip">
			<div class="feature-text">
				<span class="kicker">{RIGS_LIVE ? 'Rigs' : 'Coming soon · Rigs'}</span>
				<h3>Share your rig, play someone else's</h3>
				<p>
					A rig is a whole preset, scenes included. Publish yours on the OpenRig rigs site; browse
					the others, upvote them, keep favourites and comment. Every plugin in a rig comes from the
					OpenRig store and every amp and cabinet model from TONE3000, so the pedalboard can fetch
					all of it for you.
				</p>
				<ul class="ticks">
					<li>The whole chain: blocks, splits, settings, its 8 scenes and its tempo</li>
					<li>Upvotes, favourites and comments on every rig</li>
					<li>Install on the pedalboard in one tap: plugins and models download on their own</li>
					<li>Export and import <code>.openrig</code> files from the pedalboard too</li>
				</ul>
				{
					RIGS_LIVE ? (
						<div class="rig-ctas">
							<a class="btn btn-primary" href={RIGS_URL} data-umami-event="rigs-browse" data-umami-event-location="home">
								Browse rigs
							</a>
						</div>
					) : (
						<>
							<p class="rig-note">The rigs site is being built. Follow the project to hear when it opens.</p>
							<div class="rig-ctas">
								<a class="btn btn-primary" href={REDDIT_URL} data-umami-event="rigs-follow" data-umami-event-target="reddit">
									Follow r/OpenRig
								</a>
								<a class="btn btn-ghost" href={GITHUB_URL} data-umami-event="rigs-follow" data-umami-event-target="github">
									Star on GitHub
								</a>
							</div>
						</>
					)
				}
				<a class="more" href={`${base}/docs/using/rigs/`} data-umami-event="docs-link" data-umami-event-location="feature" data-umami-event-target="using/rigs">Sharing rigs in the docs →</a>
			</div>

			<div class="rig-visual" data-state={state} role="img" aria-label="Illustration of a shared rig: its chain (IN, Drive pedal, Lead amp, 4x12 cab, Chorus, Hall, OUT), its name and author, upvotes, favourites and comments, and an Install on pedalboard button">
				<div class="rig-ghost two" aria-hidden="true"></div>
				<div class="rig-ghost one" aria-hidden="true"></div>
				<div class="rig-card" aria-hidden="true">
					<div class="rig-head">
						<div>
							<span class="rig-name">Example Rig</span>
							<span class="rig-by">by @your-name · 8 scenes · 120 BPM</span>
						</div>
						<span class="rig-tag">Rock</span>
					</div>

					<div class="rig-chain">
						<Fragment set:html={rack} />
					</div>

					<ul class="rig-sources">
						<li><b>3</b> models from TONE3000</li>
						<li><b>2</b> plugins from the OpenRig store</li>
					</ul>

					<div class="rig-foot">
						<span class="rig-stat up">
							<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 4l9 12H3z"></path></svg>
							128
						</span>
						<span class="rig-stat">
							<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"></path></svg>
							46
						</span>
						<span class="rig-stat">
							<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M4 5h16v11H9l-5 4z"></path></svg>
							12
						</span>
						<span class="rig-install">
							<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M12 4v11M7 10l5 5 5-5M5 20h14"></path></svg>
							Install on pedalboard
						</span>
					</div>
				</div>
				<span class="rig-badge" aria-hidden="true">{RIGS_LIVE ? 'Example' : 'Preview'}</span>
			</div>
		</div>
	</div>
</section>

<style>
	.rig-note {
		margin-top: 22px;
		font-size: 15px;
		color: var(--muted);
	}

	.rig-ctas {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		margin-top: 18px;
	}

	.rig-ctas + .more {
		display: block;
		width: fit-content;
		margin-top: 22px;
	}

	/* The illustration: a rig card over two others, like a list of rigs */
	.rig-visual {
		position: relative;
		min-width: 0;
		padding: 34px 0 30px;
	}

	.rig-ghost,
	.rig-card {
		border: 1px solid var(--line-2);
		border-radius: 16px;
		background: linear-gradient(180deg, #141418, #0c0c0f);
	}

	.rig-ghost {
		position: absolute;
		left: 7%;
		right: 7%;
		height: 60px;
		opacity: 0.55;
	}

	.rig-ghost.one {
		top: 18px;
		left: 4%;
		right: 4%;
		opacity: 0.8;
	}

	.rig-ghost.two {
		top: 2px;
	}

	.rig-card {
		position: relative;
		padding: 22px 22px 20px;
		box-shadow:
			0 0 0 1px #000,
			0 40px 90px -40px rgb(240 164 60 / 0.3),
			0 30px 70px -30px rgb(0 0 0 / 0.9);
	}

	.rig-head {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 12px;
	}

	.rig-name {
		display: block;
		font-size: 21px;
		font-weight: 650;
		letter-spacing: -0.02em;
	}

	.rig-by {
		display: block;
		margin-top: 2px;
		font-size: 13.5px;
		color: var(--dim);
	}

	.rig-tag {
		padding: 3px 10px;
		border-radius: 999px;
		font-family: var(--mono);
		font-size: 12px;
		color: var(--amber);
		background: var(--amber-soft);
	}

	/* The chain, as the app's rack draws it: shrinks with the card down to
	   three quarters of its size, then scrolls */
	.rig-chain {
		margin: 22px -22px 0;
		padding: 14px 22px;
		overflow-x: auto;
		border-block: 1px solid var(--line);
		background: #050506;
		scrollbar-color: var(--line-2) transparent;
	}

	.rig-chain :global(.rig-rack) {
		display: block;
		width: 100%;
		min-width: 540px;
		height: auto;
	}

	.rig-chain :global(.rig-rack text) {
		font-feature-settings: 'calt' 0;
	}

	.rig-sources {
		display: flex;
		flex-wrap: wrap;
		gap: 6px 18px;
		margin: 16px 0 0;
		padding: 0;
		list-style: none;
		font-size: 13.5px;
		color: var(--muted);
	}

	.rig-sources b {
		color: var(--text);
	}

	.rig-foot {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 10px 18px;
		margin-top: 18px;
		padding-top: 16px;
		border-top: 1px solid var(--line);
		font-size: 14px;
		color: var(--muted);
	}

	.rig-stat {
		display: inline-flex;
		align-items: center;
		gap: 6px;
	}

	.rig-stat.up {
		color: var(--amber);
	}

	.rig-install {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		height: 38px;
		margin-left: auto;
		padding: 0 16px;
		border-radius: 9px;
		background: var(--amber);
		color: #1a1006;
		font-weight: 600;
	}

	.rig-badge {
		position: absolute;
		right: 14px;
		bottom: 2px;
		font-family: var(--mono);
		font-size: 11px;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--dim);
	}

	@media (max-width: 520px) {
		.rig-install {
			margin-left: 0;
			width: 100%;
			justify-content: center;
		}
	}
</style>
